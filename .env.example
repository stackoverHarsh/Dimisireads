# ========================================================
# DIMISIREADS ENVIRONMENT CONFIGURATION
# ========================================================
# NOTE: Never expose confidential secrets to the client.
# Client-accessible vars MUST be prefixed with NEXT_PUBLIC_.

# --- APPLICATION & HOSTING ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DimisiReads"

# --- DATABASE (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dimisireads?schema=public"

# --- AUTHENTICATION & SECURITY ---
# Generated with `openssl rand -base64 32`
SESSION_SECRET="dimisi_super_secure_session_secret_change_in_production_32b"
JWT_SECRET="dimisi_jwt_secret_token_signing_key_replace_in_production_32b"
COOKIE_DOMAIN="localhost"

# --- REDIS (Rate Limiting, Session & Metadata Caching) ---
REDIS_URL="redis://localhost:6379"

# --- EXTERNAL BIBLIOGRAPHIC METADATA APIs ---
# Used strictly for bibliographic metadata (title, author, ISBN, covers) - NEVER download rights
GOOGLE_BOOKS_API_KEY="your_google_books_api_key_here"
OPEN_LIBRARY_API_BASE="https://openlibrary.org"

# --- PRIVATE S3-COMPATIBLE OBJECT STORAGE (Cloudflare R2 / AWS S3) ---
# Used strictly for legally verified e-book assets delivered via signed URLs
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your_s3_or_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_s3_or_r2_secret_access_key"
S3_BUCKET_NAME="dimisireads-licensed-vault"
S3_FORCE_PATH_STYLE="true"

# --- AI DISCOVERY ASSISTANT (The Dimisi Librarian) ---
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="optional_fallback_openai_key"

# --- MONITORING & ERROR REPORTING ---
SENTRY_DSN=""
